# 외부 업무생산성 서비스 -> Game Q&A API 인증
API_KEY=replace-with-integration-key

# 임시 LLM provider 설정: 실제 모델 어댑터 연결 시 사용
MODEL_PROVIDER=qwen
MODEL_NAME=Qwen/Qwen3-Next-80B-A3B-Instruct
MODEL_BASE_URL=https://replace-with-openai-compatible-endpoint/v1
MODEL_API_KEY=replace-with-model-service-key
MODEL_TIMEOUT_MS=30000

# 실제 Elice ML API 연결 시 provider와 endpoint/key만 교체
# MODEL_PROVIDER=elice
# MODEL_BASE_URL=https://replace-with-elice-endpoint
# MODEL_API_KEY=replace-with-elice-key

# 선택 설정
CORS_ORIGIN=https://replace-with-productivity-origin
LORE_AGENT_URL=https://replace-with-remote-lore-agent
AGENT_PUBLIC_URL=http://localhost:3000
